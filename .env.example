# --------------------------------------------------------------------------
# SECURITY
# --------------------------------------------------------------------------
# NEVER paste real keys into chat messages, GitHub issues, screenshots, or
# any third-party tool that retains logs. Assume any pasted key is compromised
# and roll it immediately.
#
# If a key ever appears in a public channel:
#   1. Roll it in the Stripe Dashboard (Developers > API keys > ... > Roll).
#   2. Audit your account for unexpected sessions/refunds.
#   3. Update .env.local and any deployment env vars with the NEW value.
# --------------------------------------------------------------------------

# Database
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/impactrank?retryWrites=true&w=majority

# Stripe (use sk_test_... for development, sk_live_... for production)
STRIPE_SECRET_KEY=sk_test_replace_me

# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# In production, copy the endpoint's signing secret from the Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Used to build Stripe success_url / cancel_url. Include scheme, no trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
